# MongoDB Atlas connection string (no database name needed - the app uses "quickstay")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Clerk (dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk -> Webhooks -> your endpoint's "Signing Secret" (optional locally, see README)
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudinary (cloudinary.com -> Dashboard) - required for uploading room images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
# PORT=3000
# CLIENT_URL=http://localhost:5173
# MONGODB_DB_NAME=quickstay
